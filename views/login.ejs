<%- include('partials/head') %>
<main class="max-w-md mx-auto px-4 pt-8">
  <div class="w-28 h-28 rounded-full bg-brand text-white grid place-items-center font-bold mx-auto mb-8">LOGO</div>
  <form method="post" action="/login" data-anim="card" class="bg-white rounded-[2.5rem] p-8 space-y-5">
    <h1 class="text-3xl font-bold text-center mb-4">Login</h1>
    <label class="flex items-center gap-3 bg-gray-100 border border-gray-200 rounded-full px-5 py-4"><i class="bi bi-envelope text-gray-400"></i><input name="email" type="email" required placeholder="Email" class="bg-transparent outline-none w-full"></label>
    <label class="flex items-center gap-3 bg-gray-100 border border-gray-200 rounded-full px-5 py-4"><i class="bi bi-lock text-gray-400"></i><input name="password" type="password" required placeholder="Password" class="bg-transparent outline-none w-full"></label>
    <p class="text-center text-sm text-gray-400 pt-2">Lupa password? Hubungi admin lain untuk reset di database.</p>
    <button class="w-full bg-brand text-brand-lime rounded-full py-4 text-xl">Login</button>
  </form>
</main>
<%- include('partials/foot') %>
