<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> · Kas SI01A</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={theme:{extend:{colors:{brand:{DEFAULT:'#17451a',lime:'#b2ec75',soft:'#cdf19f',bg:'#e8ecea',mid:'#5a6b66'}},fontFamily:{sans:['Plus Jakarta Sans','ui-sans-serif','system-ui','sans-serif']}}}}</script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>dialog{border:0;padding:0;background:transparent;max-width:100%}dialog::backdrop{background:rgba(23,69,26,.45)}</style>
</head>
<body class="bg-brand-bg font-sans text-brand min-h-screen <%= user ? 'pb-28 xl:pb-10' : 'pb-10' %> pt-[76px] md:pt-[88px]">
<header class="bg-white fixed top-0 inset-x-0 z-30 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 xl:py-4 flex items-center gap-4">
    <div class="w-11 h-11 md:w-14 md:h-14 rounded-full bg-brand text-white grid place-items-center text-[10px] md:text-xs font-bold shrink-0">LOGO</div>
    <div class="leading-tight min-w-0">
      <div class="font-bold text-lg md:text-2xl">Hello, SI01A</div>
      <div class="text-xs md:text-base truncate">Ringkasan uang kas hari ini</div>
    </div>
    <% if (user) { %>
    <nav class="hidden xl:flex gap-3 ml-10">
      <% nav.forEach(n => { %><a href="<%= n[0] %>" class="px-8 py-3 rounded-xl text-sm <%= active===n[0] ? 'bg-brand text-brand-lime' : 'bg-black/10 hover:bg-black/20' %>"><%= n[1] %></a><% }) %>
    </nav>
    <% } %>
    <div class="ml-auto">
      <% if (user) { %>
      <form method="post" action="/logout"><button class="btn-arrow flex items-center gap-3 bg-brand text-brand-lime rounded-full pl-5 pr-1.5 py-1.5 text-sm">Logout <span class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-brand-lime text-brand grid place-items-center overflow-hidden"><i class="bi bi-arrow-up-right block"></i></span></button></form>
      <% } else { %>
      <a href="/login" class="btn-arrow flex items-center gap-3 bg-brand text-brand-lime rounded-full pl-5 pr-1.5 py-1.5 text-sm">Login <span class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-brand-lime text-brand grid place-items-center overflow-hidden"><i class="bi bi-arrow-up-right block"></i></span></a>
      <% } %>
    </div>
  </div>
</header>
<% if (msg || err) { %>
<div class="max-w-7xl mx-auto px-4 md:px-8 mt-3" data-anim="card"><div class="rounded-2xl px-4 py-3 text-sm <%= err ? 'bg-red-100 text-red-800' : 'bg-brand-soft text-brand' %>"><i class="bi <%= err ? 'bi-exclamation-circle' : 'bi-check-circle' %> mr-1"></i><%= err || msg %></div></div>
<% } %>
